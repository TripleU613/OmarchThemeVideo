# What stays on your machine, and why.
#
# The song (music-video/assets/audio/song.wav) and its words (music-video/lyrics.txt,
# built into music-video/assets/lib/lyrics.js) are tracked. npm run verify stops the
# silent placeholder song and the placeholder words from being committed.

# Raw source material: the master the analysis reads, the lyric sheet, stems.
source/

# Generated or heavy: renders, snapshot caches, contact sheets, separated stems, model caches, environments.
music-video/storyboard/*.jpg
music-video/renders/
music-video/.hyperframes/
# HyperFrames Studio caches: preview thumbnails and the song's waveform.
music-video/.thumbnails/
music-video/.waveform-cache/
analysis/stems/
analysis/*.npz
.venv*/
node_modules/
__pycache__/

# Neighbouring projects in the same folder, not part of this one.
omarchy-site/
reference-jtech-lyric-video/

# Editor and OS noise.
.DS_Store
*.swp

# An early speech-to-text attempt, superseded by the forced aligner.
analysis/whisper/
