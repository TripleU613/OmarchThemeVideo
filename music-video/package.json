{
  "name": "music-video",
  "private": true,
  "type": "module",
  "description": "A music video for the Omarchy anthem, made entirely in code.",
  "homepage": "https://github.com/TripleU613/OmarchThemeVideo",
  "repository": {
    "type": "git",
    "url": "https://github.com/TripleU613/OmarchThemeVideo.git",
    "directory": "music-video"
  },
  "scripts": {
    "serve": "python3 scripts/serve.py 3123",
    "assemble": "node scripts/assemble.mjs",
    "timing": "node scripts/build-timing.mjs",
    "facts": "node scripts/scene-facts.mjs",
    "lyrics:from": "node scripts/lyrics-from-lrc.mjs",
    "lyrics:build": "node scripts/build-lyrics.mjs",
    "lyrics:placeholder": "node scripts/build-lyrics.mjs --placeholder",
    "verify": "node scripts/verify.mjs",
    "qa-sheet": "node scripts/qa-sheet.mjs",
    "snapshot": "npx --yes hyperframes@0.8.166 snapshot --no-end --timeout 60000",
    "dev": "npx --yes hyperframes@0.8.166 preview",
    "check": "npx --yes hyperframes@0.8.166 check",
    "render": "npx --yes hyperframes@0.8.166 render",
    "render:preview": "npx --yes hyperframes@0.8.166 render --quality draft --fps 24 --workers 6 --player-ready-timeout 120000 -o renders/preview.mp4",
    "render:4k": "node scripts/render-final.mjs",
    "publish": "npx --yes hyperframes@0.8.166 publish",
    "audio:placeholder": "node scripts/placeholder-audio.mjs"
  }
}
